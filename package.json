{
  "name": "helm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @helm/server --filter @helm/web dev",
    "build": "pnpm --filter @helm/web build && pnpm --filter @helm/server build",
    "start": "pnpm --filter @helm/server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @helm/db generate"
  }
}
