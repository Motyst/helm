# Copy to .env and adjust.

# --- Server ---
HELM_PORT=8787
HELM_DB_PATH=./data/helm.db

# Owner login for the web app. Use something long.
HELM_OWNER_PASSWORD=change-me
# Random string used to sign session cookies (e.g. `openssl rand -hex 32`).
HELM_SESSION_SECRET=replace-with-random-hex
# Set to true when served over HTTPS (Tailscale serve, Fly, etc.).
HELM_COOKIE_SECURE=false
# Serve the built app (pnpm build) from the server, so one port runs everything.
# Relative to apps/server. Leave empty to serve the API only.
HELM_WEB_DIST=../web/dist

# --- Task rules ---
# Max tasks in progress at once. Starting one more demotes the oldest. 0 = unlimited.
HELM_IN_PROGRESS_LIMIT=1
# How deep subtasks may nest. 1 = subtasks cannot have subtasks.
HELM_MAX_SUBTASK_DEPTH=1

# --- AI providers (used from step 9) ---
HELM_LLM_PROVIDER=openai
HELM_STT_PROVIDER=openai
OPENAI_API_KEY=
